{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    // `WebWorker`, not `DOM`: this file runs in `DedicatedWorkerGlobalScope`,
    // not `Window` -- the two libs declare conflicting globals (`self`,
    // `postMessage`) and can't both be active in one TS project, which is
    // exactly why this is a separate project rather than folded into
    // `tsconfig.app.json`'s `["ES2023", "DOM"]` (same reasoning as
    // `tsconfig.node.json` existing separately for the Node-context config
    // files).
    "lib": ["ES2023", "WebWorker"],
    // `@webgpu/types`: WebGPU isn't in TypeScript's built-in DOM lib, and
    // it's only needed by Worker-scope code (`renderer.ts`), so it's scoped
    // to this project rather than the app's.
    "types": ["vite/client", "@webgpu/types"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/emulator/emulatorWorker.ts", "src/emulator/renderer.ts"]
}
